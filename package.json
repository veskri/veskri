{
  "name": "veskri",
  "private": true,
  "version": "1.5.1",
  "description": "Fast, privacy-minded desktop dictation powered by Groq.",
  "author": "KingIronMan2011",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-to-text",
    "speech-to-text",
    "whisper",
    "tauri"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veskri/veskri.git"
  },
  "homepage": "https://github.com/veskri/veskri#readme",
  "bugs": {
    "url": "https://github.com/veskri/veskri/issues"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:ci:linux": "tauri build --bundles appimage,deb,rpm --features local-whisper-vulkan",
    "build:ci:linux-cuda": "tauri build --bundles appimage,deb,rpm --features local-whisper-cuda",
    "build:ci:linux-rocm": "tauri build --bundles appimage,deb,rpm --features local-whisper-rocm",
    "build:ci:linux-intel": "tauri build --bundles appimage,deb,rpm --features local-whisper-intel-sycl",
    "build:ci:mac": "tauri build --bundles app,dmg --no-sign --features local-whisper-metal",
    "build:ci:windows": "tauri build --features local-whisper-vulkan",
    "build:ci:windows-cuda": "tauri build --features local-whisper-cuda",
    "build:ci:windows-intel": "tauri build --features local-whisper-intel-sycl",
    "types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "pnpm metadata:check && pnpm test && pnpm test:rust && pnpm test:e2e",
    "metadata:check": "tsx scripts/check-metadata.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
