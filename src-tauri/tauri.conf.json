{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veskri",
  "version": "1.5.1",
  "identifier": "dev.kingironman.veskri",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veskri",
        "width": 1120,
        "height": 850,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "KingIronMan2011",
    "homepage": "https://github.com/veskri/veskri",
    "copyright": "Copyright © 2026 KingIronMan2011",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Fast, privacy-minded desktop dictation powered by Groq.",
    "longDescription": "Veskri is an open-source desktop dictation app for Windows, macOS, and Linux. Hold a shortcut, speak naturally, and continue writing.",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "c061f7a3-65a7-54c0-8128-2dddf7a7a20f"
      }
    }
  },
  "plugins": {
    "updater": {
      "createUpdaterArtifacts": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMjNBMEE1QTI3MkM3RjUKUldUMXgzS2lwYUFqVGxaQ3lQK2FyT2U5MFYwYTc1Q2ZpK3BZT1pDSXc2eUo4RG9OKy9lZm1CRjUK",
      "endpoints": [
        "https://github.com/veskri/veskri/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
